#!/usr/bin/env python3
"""jarvis — JARVIS 2.0: turn one idea into one long-running research project.

Single-file, stdlib-only, readable top to bottom. The division of labor:

  state    = the project directory (git-tracked files, per-file ownership)
  policy   = keeper.md (a prompt contract for an autonomous Claude session)
  plumbing = this CLI: scaffold, schedule, invoke, verify, account

Commands:
  jarvis new "<idea>" [--slug s]    idea -> projects/<slug>/  (status: incubating)
  jarvis new --explore "<interests>" --repo URL [--hours H] [--parallelism N]
                                    point an exploration at a repo (mode: explore)
  jarvis list                       one row per project
  jarvis status <slug>              config, state, spend, recent log, frontier head
  jarvis tick [<slug>]              run due keeper ticks; bare form = cron entrypoint
  jarvis open <slug>                interactive Claude session inside the project
  jarvis pause|resume|drop <slug> [--reason ...]
  jarvis outcome <slug> <progress|blocked|done|spec-ready> --note "..."
                                    record how a tick ended (called by the keeper)
"""

import argparse
import concurrent.futures
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent  # jarvis2/
PROJECTS = ROOT / "projects"
TEMPLATE = PROJECTS / "TEMPLATE"
TEMPLATE_EXPLORE = PROJECTS / "TEMPLATE-explore"
KEEPER_DOC = ROOT / "keeper.md"
EXPLORER_DOC = ROOT / "keeper-explore.md"

DEFAULT_CADENCE_MIN = 120
DEFAULT_TIMEOUT_MIN = 45
DEFAULT_BUDGET_USD = 20.0
DEFAULT_EXPLORE_HOURS = 16.0
DEFAULT_EXPLORE_USD = 100.0
DEFAULT_PARALLELISM = 4

# ---------------------------------------------------------------- helpers

def now_iso() -> str:
    return datetime.now().astimezone().isoformat(timespec="seconds")


def die(msg: str) -> None:
    print(f"jarvis: {msg}", file=sys.stderr)
    sys.exit(1)


def flare(msg: str, sev: str = "info") -> None:
    """One channel out. Best-effort: a missing flare CLI must not break a tick."""
    try:
        subprocess.run(["flare", msg, "--sev", sev], check=False, timeout=30)
    except (FileNotFoundError, subprocess.TimeoutExpired):
        print(f"[flare {sev}] {msg}", file=sys.stderr)


def git(*args: str, check: bool = False) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["git", "-C", str(ROOT), *args], capture_output=True, text=True, check=check
    )


def project_dir(slug: str) -> Path:
    p = PROJECTS / slug
    if not (p / "project.toml").exists():
        die(f"no such project: {slug} (see `jarvis list`)")
    return p


def all_slugs() -> list[str]:
    if not PROJECTS.exists():
        return []
    return sorted(
        d.name
        for d in PROJECTS.iterdir()
        if d.is_dir() and not d.name.startswith("TEMPLATE")
        and (d / "project.toml").exists()
    )


# ------------------------------------------------- per-project state I/O

def parse_toml(text: str) -> dict:
    """Constrained TOML: comments, [tables], key = string|number|bool.

    project.toml's documented subset — deliberately tiny so the CLI needs no
    interpreter newer than stock python3 and no dependencies.
    """
    out: dict = {}
    table = out
    for raw in text.splitlines():
        line = raw.strip()
        if "#" in line:
            q = False
            for i, ch in enumerate(line):
                if ch == '"':
                    q = not q
                elif ch == "#" and not q:
                    line = line[:i].rstrip()
                    break
        if not line:
            continue
        if line.startswith("[") and line.endswith("]"):
            table = out.setdefault(line[1:-1].strip(), {})
            continue
        if "=" not in line:
            continue
        key, val = (s.strip() for s in line.split("=", 1))
        if val.startswith('"') and val.endswith('"'):
            table[key] = val[1:-1]
        elif val in ("true", "false"):
            table[key] = val == "true"
        else:
            try:
                table[key] = int(val) if re.fullmatch(r"-?\d+", val) else float(val)
            except ValueError:
                table[key] = val
    return out


def load_config(pdir: Path) -> dict:
    return parse_toml((pdir / "project.toml").read_text())


def load_state(pdir: Path) -> dict:
    f = pdir / "state.json"
    if f.exists():
        return json.loads(f.read_text())
    return {"status": "incubating", "status_reason": "", "ticks": 0,
            "last_tick_start": None, "last_tick_id": None}


def save_state(pdir: Path, st: dict) -> None:
    (pdir / "state.json").write_text(json.dumps(st, indent=2) + "\n")


def set_status(pdir: Path, status: str, reason: str = "") -> None:
    st = load_state(pdir)
    st["status"], st["status_reason"] = status, reason
    save_state(pdir, st)


def append_log(pdir: Path, entry: dict) -> None:
    entry = {"t": now_iso(), **entry}
    with open(pdir / "log.jsonl", "a") as f:
        f.write(json.dumps(entry) + "\n")


def read_log(pdir: Path) -> list[dict]:
    f = pdir / "log.jsonl"
    if not f.exists():
        return []
    out = []
    for line in f.read_text().splitlines():
        line = line.strip()
        if line:
            try:
                out.append(json.loads(line))
            except json.JSONDecodeError:
                pass
    return out


def spent_usd(pdir: Path) -> float:
    return sum(
        e.get("cost_usd") or 0.0 for e in read_log(pdir) if e.get("event") == "tick_end"
    )


def budget_usd(cfg: dict) -> float:
    default = DEFAULT_EXPLORE_USD if mode_of(cfg) == "explore" else DEFAULT_BUDGET_USD
    return float(cfg.get("budget", {}).get("usd", default))


def mode_of(cfg: dict) -> str:
    return cfg.get("mode", "research")


def hours_cap(cfg: dict) -> float:
    return float(cfg.get("budget", {}).get("hours", DEFAULT_EXPLORE_HOURS))


def hours_spent(pdir: Path) -> float:
    """Wall-clock hours delivered: survey ticks + wave wall time (a wave of N
    parallel workers counts its wall clock once — hours are human-time; the
    agent-hours multiplier is parallelism's job)."""
    total = 0.0
    for e in read_log(pdir):
        if e.get("event") == "wave_end":
            total += e.get("wall_s") or 0.0
        elif e.get("event") == "tick_end" and e.get("role") in (None, "survey"):
            total += e.get("duration_s") or 0.0
    return total / 3600.0


def age_str(iso: str | None) -> str:
    if not iso:
        return "never"
    delta = datetime.now().astimezone() - datetime.fromisoformat(iso)
    s = int(delta.total_seconds())
    if s < 3600:
        return f"{s // 60}m ago"
    if s < 86400:
        return f"{s // 3600}h ago"
    return f"{s // 86400}d ago"


# ---------------------------------------------------------------- new

def slugify(text: str) -> str:
    words = re.sub(r"[^a-z0-9 ]", "", text.lower()).split()
    return "-".join(words[:5]) or "unnamed"


def cmd_new(args) -> None:
    slug = args.slug or slugify(args.idea)
    pdir = PROJECTS / slug
    if pdir.exists():
        die(f"projects/{slug} already exists")
    template = TEMPLATE_EXPLORE if args.explore else TEMPLATE
    shutil.copytree(template, pdir)
    date = datetime.now().strftime("%Y-%m-%d")
    names = (("project.toml", "interests.md", "frontier.md", "findings.md")
             if args.explore else ("project.toml", "spec.md", "frontier.md"))
    for name in names:
        f = pdir / name
        f.write_text(
            f.read_text()
            .replace("{{SLUG}}", slug)
            .replace("{{DATE}}", date)
            .replace("{{IDEA}}", args.idea.strip())
            .replace("{{REPO}}", args.repo or "")
            .replace("{{HOURS}}", str(args.hours))
            .replace("{{USD}}", str(args.budget_usd))
            .replace("{{PARALLELISM}}", str(args.parallelism))
        )
    save_state(pdir, load_state(pdir))  # materialize state.json
    append_log(pdir, {"event": "created", "idea": args.idea.strip()})
    git("add", str(pdir))
    git("commit", "-m", f"jarvis2/{slug}: new project (incubating)")
    print(f"created projects/{slug} (incubating)")
    if args.explore:
        print(f"explore mode: {args.hours}h x {args.parallelism} workers, "
              f"${args.budget_usd:.0f} cap — survey tick seeds the question queue: "
              f"jarvis tick {slug}")
    else:
        print(f"next tick drafts the spec: jarvis tick {slug}")


# ---------------------------------------------------------------- list / status

def cmd_list(args) -> None:
    slugs = all_slugs()
    if not slugs:
        print("no projects yet — jarvis new \"<idea>\"")
        return
    print(f"{'PROJECT':<28} {'STATUS':<11} {'TICKS':>5} {'SPENT':>14} {'LAST TICK':>10}")
    for slug in slugs:
        pdir = PROJECTS / slug
        cfg, st = load_config(pdir), load_state(pdir)
        spend = f"${spent_usd(pdir):.2f}/${budget_usd(cfg):.0f}"
        print(f"{slug:<28} {st['status']:<11} {st['ticks']:>5} {spend:>14} "
              f"{age_str(st['last_tick_start']):>10}")
        if st.get("status_reason"):
            print(f"{'':<28} └ {st['status_reason']}")


def cmd_status(args) -> None:
    pdir = project_dir(args.slug)
    cfg, st = load_config(pdir), load_state(pdir)
    print(f"projects/{args.slug}  [{st['status']}]"
          + (f"  — {st['status_reason']}" if st.get("status_reason") else ""))
    print(f"  ticks: {st['ticks']}   spent: ${spent_usd(pdir):.2f} of "
          f"${budget_usd(cfg):.2f}   cadence: {cfg.get('cadence_minutes', DEFAULT_CADENCE_MIN)}m"
          f"   last tick: {age_str(st['last_tick_start'])}")
    print("\nrecent log:")
    for e in read_log(pdir)[-6:]:
        extra = e.get("outcome") or e.get("note") or e.get("result_tail", "")
        print(f"  {e['t']}  {e['event']:<10} {str(extra)[:90]}")
    frontier = (pdir / "frontier.md")
    if frontier.exists():
        print("\nfrontier head:")
        for line in frontier.read_text().splitlines()[:15]:
            print(f"  {line}")


# ---------------------------------------------------------------- tick

def is_due(cfg: dict, st: dict) -> bool:
    if st["status"] == "incubating":
        return True
    if st["status"] != "active":
        return False
    last = st.get("last_tick_start")
    if not last:
        return True
    default_cadence = 0 if mode_of(cfg) == "explore" else DEFAULT_CADENCE_MIN
    cadence = float(cfg.get("cadence_minutes", default_cadence))
    elapsed = (datetime.now().astimezone() - datetime.fromisoformat(last)).total_seconds()
    return elapsed >= cadence * 60


def autonomy_clause(slug: str, spend: float, cap: float, hrs: float, hcap: float) -> str:
    """The guarantees, restated where they bind: in every explore prompt."""
    return (
        f"Standing authorization: spend inside the caps (${spend:.2f} of ${cap:.2f} used; "
        f"{hrs:.1f}h of {hcap:.1f}h delivered) is PRE-APPROVED — the plumbing enforces the caps, "
        f"you never ask, hesitate, or leave cheap experiments unrun to be safe. Every decision is "
        f"yours: decide with best judgment and record it in frontier.md Decisions. 'blocked' is "
        f"ONLY for hard external blockers (missing credential, service down, no access) — never "
        f"'needs a decision'. There is no early finish: a dead end means the next question, an "
        f"empty queue means generating questions IS the work. "
    )


def build_prompt(slug: str, tick_id: str, st: dict, spend: float, cap: float,
                 cfg: dict | None = None) -> str:
    cfg = cfg or {}
    if st["status"] == "incubating" and mode_of(cfg) == "explore":
        n = int(cfg.get("parallelism", DEFAULT_PARALLELISM))
        repo = cfg.get("work", {}).get("repo", "")
        return (
            f"You are the SURVEY session for jarvis2 explore project '{slug}', tick {tick_id} — "
            f"its first tick. Daniel's interests are in ./interests.md (verbatim); the repo under "
            f"exploration is {repo or '(none — idea-space exploration)'}. Your policy is "
            f"{EXPLORER_DOC} (Survey role): clone the repo to work/repo/ if one is set, survey it, "
            f"seed questions/queue/ with at least {2 * n} mini-spec'd questions, write frontier.md. "
            + autonomy_clause(slug, spend, cap, hours_spent(PROJECTS / slug), hours_cap(cfg))
            + f"End by committing and running: jarvis outcome {slug} spec-ready --note "
            f"\"<one-line queue summary>\". Waves of {n} parallel workers start next tick."
        )
    if st["status"] == "incubating":
        return (
            f"You are the keeper for jarvis2 project '{slug}', tick {tick_id} — its FIRST tick. "
            f"Daniel's idea is in ./spec.md under '## Idea'. This tick drafts the spec, not the work: "
            f"research the context you need (this repo, ~/jarvis-memory, the project's pointers), then "
            f"rewrite ./spec.md — keep the idea verbatim, fill Motivation, Definition of done, and "
            f"Approach. Follow the policy in {KEEPER_DOC}. End by committing your changes and running: "
            f"jarvis outcome {slug} spec-ready --note \"<one-line spec summary>\" "
            f"(or jarvis outcome {slug} blocked --note ... if you genuinely cannot draft it)."
        )
    return (
        f"You are the keeper for jarvis2 project '{slug}', tick {tick_id}. "
        f"Read ./spec.md and ./frontier.md, then do the single most valuable next unit of work "
        f"toward the Definition of done. Your policy is {KEEPER_DOC} — follow its tick contract. "
        f"Spend so far: ${spend:.2f} of ${cap:.2f}. End by updating ./frontier.md, committing, and "
        f"recording exactly one outcome: "
        f"jarvis outcome {slug} progress|blocked|done --note \"<what happened>\""
    )


def runner_tick(pdir: Path, cfg: dict, prompt: str, env: dict, timeout: float) -> dict:
    """Runner "tick": one bounded headless Claude session.

    A runner's contract with the plumbing: do the work however it likes — one
    session, a resident process, a fleet of communicating agents — and return
    accounting {cost_usd, duration_s, is_error, result_tail[, error]}. It never
    touches state.json or outcomes; verification, budget, checkpoint, and
    flares stay in run_tick, runner-agnostic. A future runner that outlives
    its invocation ("resident", "fleet") replaces the timeout with a
    heartbeat/lease recorded through the same log.jsonl.
    """
    cmd = ["claude", "-p", prompt, "--output-format", "json",
           "--dangerously-skip-permissions"]
    if cfg.get("model"):
        cmd += ["--model", cfg["model"]]
    t0 = time.time()
    try:
        proc = subprocess.run(cmd, cwd=str(pdir), env=env, timeout=timeout,
                              capture_output=True, text=True)
    except subprocess.TimeoutExpired:
        return {"is_error": True, "duration_s": round(time.time() - t0),
                "error": "timeout"}
    cost, result_tail, is_error = None, "", proc.returncode != 0
    try:
        data = json.loads(proc.stdout)
        cost = data.get("total_cost_usd")
        result_tail = (data.get("result") or "")[-400:]
        is_error = bool(data.get("is_error", is_error))
    except json.JSONDecodeError:
        result_tail = (proc.stdout or proc.stderr)[-400:]
    return {"cost_usd": cost, "duration_s": round(time.time() - t0),
            "is_error": is_error, "result_tail": result_tail}


RUNNERS = {"tick": runner_tick}


# ------------------------------------------------------------ explore waves

def worker_prompt(slug: str, role: str, qrel: str | None, tick_id: str,
                  spend: float, cap: float, hrs: float, hcap: float) -> str:
    base = autonomy_clause(slug, spend, cap, hrs, hcap) + (
        f"Policy: {EXPLORER_DOC}. Ownership law: you write ONLY notes/ and work/ — never "
        f"findings.md, frontier.md, questions/, reports/ — and you NEVER run git commit "
        f"(plumbing commits; parallel workers racing the git index is the alternative). ")
    if role == "generate":
        return (
            f"You are the GENERATOR in a parallel exploration wave for jarvis2 project '{slug}' "
            f"(tick {tick_id}): the question queue ran short. Read interests.md, findings.md, "
            f"frontier.md and questions/, then draft diverse new mini-spec'd questions into "
            f"notes/generated-{tick_id}.md for the synthesizer to triage. " + base)
    return (
        f"You are one WORKER in a parallel exploration wave for jarvis2 project '{slug}' "
        f"(tick {tick_id}). Your assigned question is ./{qrel} — work ONLY that question: "
        f"sharpen its mini-spec if skeletal, pilot cheaply, scale if the pilot says something, "
        f"and finish by writing notes/{Path(qrel).stem}-{tick_id}.md with verdict + evidence + "
        f"follow-up questions. A worker that ends without a notes file is a broken worker. "
        + base)


def synth_prompt(slug: str, tick_id: str, n_workers: int, spend: float, cap: float,
                 hrs: float, hcap: float, parallelism: int) -> str:
    return (
        f"You are the SYNTHESIZER for jarvis2 explore project '{slug}', closing wave {tick_id} "
        f"({n_workers} workers just ran). Policy: {EXPLORER_DOC} (Synthesizer role): merge new "
        f"notes/ into findings.md and delete merged notes; retire questions/claimed/ to "
        f"questions/done/ with verdicts; replenish questions/queue/ to >= {2 * parallelism} "
        f"questions ranked against findings.md (discriminating, cheap-to-pilot first, no "
        f"near-duplicates); update frontier.md; digest report every ~5 waves or on a surprise. "
        + autonomy_clause(slug, spend, cap, hrs, hcap)
        + f"End with: jarvis outcome {slug} progress --note \"<one line: wave verdicts>\"."
    )


def run_explore_wave(pdir: Path, slug: str, cfg: dict, tick_id: str,
                     env: dict, timeout: float, spend: float, cap: float) -> None:
    """One wave: claim up to N questions, run N workers in parallel (own-files-only,
    no commits), then one synthesizer over the shared state. Hours are a ledger the
    scheduler owns: cron keeps firing waves until hours_cap is delivered — no
    session can end the run early (persistence guarantee lives here, not in prompts)."""
    hrs, hcap = hours_spent(pdir), hours_cap(cfg)
    n = int(cfg.get("parallelism", DEFAULT_PARALLELISM))
    if hrs >= hcap:
        finish_exploration(pdir, slug, cfg, tick_id, env, timeout, spend, cap, hrs, hcap)
        return

    queue = sorted((pdir / "questions" / "queue").glob("q-*.md"))
    roles: list[tuple[str, str | None]] = []
    for q in queue[:n]:
        dest = pdir / "questions" / "claimed" / q.name
        q.rename(dest)  # atomic; synth/survey are the only queue writers, so no race
        roles.append(("worker", str(dest.relative_to(pdir))))
    if len(roles) < n:
        roles.append(("generate", None))  # queue ran short: replenishing IS work

    t0 = time.time()
    print(f"[{slug}] wave {tick_id}: {len(roles)} parallel sessions "
          f"({hrs:.1f}h of {hcap:.1f}h delivered)")

    def run_one(i: int, role: str, qrel: str | None) -> dict:
        wenv = {**env, "JARVIS2_ROLE": role, "JARVIS2_TICK_ID": f"{tick_id}.w{i}"}
        prompt = worker_prompt(slug, role, qrel, tick_id, spend, cap, hrs, hcap)
        return runner_tick(pdir, cfg, prompt, wenv, timeout)

    with concurrent.futures.ThreadPoolExecutor(max_workers=max(len(roles), 1)) as ex:
        futs = [ex.submit(run_one, i, role, qrel)
                for i, (role, qrel) in enumerate(roles)]
        accts = [f.result() for f in futs]
    broken = 0
    for (role, qrel), acct in zip(roles, accts):
        note = (pdir / "notes" / (f"generated-{tick_id}.md" if role == "generate"
                                  else f"{Path(qrel).stem}-{tick_id}.md"))
        wrote = note.exists()
        broken += 0 if wrote else 1
        append_log(pdir, {"event": "tick_end", "tick": tick_id, "role": role,
                          "question": qrel, "wrote_note": wrote, **acct})
    if broken:
        flare(f"jarvis2/{slug} wave {tick_id}: {broken}/{len(roles)} workers ended "
              f"without a notes file — check projects/{slug}/log.jsonl", sev="warn")

    senv = {**env, "JARVIS2_ROLE": "synth"}
    sacct = runner_tick(pdir, cfg, synth_prompt(slug, tick_id, len(roles), spend, cap,
                                                hrs, hcap, n), senv, timeout)
    append_log(pdir, {"event": "tick_end", "tick": tick_id, "role": "synth", **sacct})
    append_log(pdir, {"event": "wave_end", "tick": tick_id, "wall_s": round(time.time() - t0),
                      "workers": len(roles), "broken": broken,
                      "cost_usd": round(sum(a.get("cost_usd") or 0.0
                                            for a in accts + [sacct]), 4)})

    outcomes = [e for e in read_log(pdir)
                if e.get("event") == "outcome" and e.get("tick") == tick_id]
    if not outcomes:
        flare(f"jarvis2/{slug}: wave {tick_id} synthesizer recorded NO outcome — "
              f"check projects/{slug}/log.jsonl", sev="warn")
    print(f"[{slug}] wave {tick_id} done: "
          f"{outcomes[0]['outcome'] if outcomes else 'NO OUTCOME'} "
          f"(${sum(a.get('cost_usd') or 0.0 for a in accts + [sacct]):.2f}, "
          f"{round(time.time() - t0)}s wall)")
    checkpoint(pdir, slug, tick_id)


def finish_exploration(pdir: Path, slug: str, cfg: dict, tick_id: str, env: dict,
                       timeout: float, spend: float, cap: float,
                       hrs: float, hcap: float) -> None:
    """Hours delivered in full: one wrap-up session writes the final digest, then done.
    `done` here means 'the configured run was delivered', never 'an agent gave up' —
    raising [budget].hours + `jarvis resume` continues the same exploration."""
    prompt = (
        f"You are the WRAP-UP synthesizer for jarvis2 explore project '{slug}' (tick {tick_id}): "
        f"the configured {hcap:.1f}h of exploration has been delivered ({hrs:.1f}h logged). "
        f"Read findings.md, frontier.md and reports/, then write reports/final.md — a digest "
        f"Daniel reads in five minutes: top findings vs interests.md, dead ends worth not "
        f"repeating, and the open questions most worth a follow-up project. Policy: "
        f"{EXPLORER_DOC}. End with: jarvis outcome {slug} progress --note \"final digest\".")
    acct = runner_tick(pdir, cfg, prompt, {**env, "JARVIS2_ROLE": "synth"}, timeout)
    append_log(pdir, {"event": "tick_end", "tick": tick_id, "role": "synth",
                      "wrapup": True, **acct})
    set_status(pdir, "done", f"hours budget delivered ({hcap:.1f}h)")
    flare(f"jarvis2/{slug} DONE: {hcap:.1f}h of exploration delivered (${spend:.2f} of "
          f"${cap:.2f}) — digest: projects/{slug}/reports/final.md; to continue, raise "
          f"[budget].hours in project.toml and `jarvis resume {slug}`")
    checkpoint(pdir, slug, tick_id)


def run_tick(slug: str) -> None:
    pdir = project_dir(slug)
    cfg, st = load_config(pdir), load_state(pdir)
    runner_name = cfg.get("keeper", {}).get("runner", "tick")
    runner = RUNNERS.get(runner_name)
    if runner is None:
        set_status(pdir, "blocked", f"unknown keeper runner '{runner_name}'")
        flare(f"jarvis2/{slug} BLOCKED: project.toml names keeper runner "
              f"'{runner_name}' but this CLI only knows {sorted(RUNNERS)}", sev="warn")
        return
    spend, cap = spent_usd(pdir), budget_usd(cfg)
    if spend >= cap:
        set_status(pdir, "blocked", f"budget exhausted (${spend:.2f} >= ${cap:.2f})")
        append_log(pdir, {"event": "budget_exhausted", "spent": spend})
        flare(f"jarvis2/{slug} BLOCKED: budget exhausted (${spend:.2f} of ${cap:.2f}) — "
              f"raise [budget].usd in project.toml and `jarvis resume {slug}`", sev="warn")
        return

    tick_id = datetime.now().strftime("%Y%m%dT%H%M%S")
    st.update(last_tick_start=now_iso(), last_tick_id=tick_id, ticks=st["ticks"] + 1)
    save_state(pdir, st)
    append_log(pdir, {"event": "tick_start", "tick": tick_id, "mode": st["status"],
                      "runner": runner_name})
    print(f"[{slug}] tick {tick_id} ({st['status']}, runner={runner_name}) ...")

    env = {**os.environ,
           "JARVIS2_TICK_ID": tick_id,
           "JARVIS2_PROJECT": slug,
           "PATH": f"{ROOT / 'bin'}:{os.environ.get('PATH', '')}"}
    timeout = float(cfg.get("tick_timeout_minutes", DEFAULT_TIMEOUT_MIN)) * 60
    if mode_of(cfg) == "explore" and st["status"] == "active":
        run_explore_wave(pdir, slug, cfg, tick_id, env, timeout, spend, cap)
        return
    acct = runner(pdir, cfg, build_prompt(slug, tick_id, st, spend, cap, cfg), env, timeout)
    append_log(pdir, {"event": "tick_end", "tick": tick_id, **acct})
    if acct.get("error") == "timeout":
        flare(f"jarvis2/{slug}: tick {tick_id} hit the {timeout / 60:.0f}m timeout and was killed "
              f"— check projects/{slug}/log.jsonl", sev="warn")
        checkpoint(pdir, slug, tick_id)
        return

    # Trust-but-verify: the keeper's one hard obligation is a recorded outcome.
    outcomes = [e for e in read_log(pdir)
                if e.get("event") == "outcome" and e.get("tick") == tick_id]
    if not outcomes:
        flare(f"jarvis2/{slug}: tick {tick_id} ended with NO recorded outcome "
              f"(is_error={acct.get('is_error')}) — check projects/{slug}/log.jsonl", sev="warn")
    print(f"[{slug}] tick {tick_id} done: "
          f"{outcomes[0]['outcome'] if outcomes else 'NO OUTCOME'} "
          f"(${acct.get('cost_usd') or 0:.2f}, {acct.get('duration_s')}s)")
    checkpoint(pdir, slug, tick_id)


def checkpoint(pdir: Path, slug: str, tick_id: str) -> None:
    """Guarantee tick bookkeeping lands in git even if the keeper forgot to commit."""
    dirty = git("status", "--porcelain", "--", str(pdir)).stdout.strip()
    if dirty:
        git("add", str(pdir))
        git("commit", "-m", f"jarvis2/{slug}: tick {tick_id} checkpoint")
    push = git("push", "origin", "HEAD")
    if push.returncode != 0:
        print(f"[{slug}] push failed: {push.stderr.strip()[:200]}", file=sys.stderr)


def maybe_auto_resume(slug: str) -> None:
    """Autonomy guarantee, enforced: in explore mode a lone `blocked` is treated
    as a soft block and auto-resumed — it sticks only when two consecutive
    outcomes blocked (a rediscovered hard blocker). Plumbing-set blocks
    (budget exhausted, bad runner) always stick."""
    pdir = PROJECTS / slug
    cfg, st = load_config(pdir), load_state(pdir)
    if mode_of(cfg) != "explore" or st["status"] != "blocked":
        return
    reason = st.get("status_reason", "")
    if reason.startswith(("budget exhausted", "unknown keeper runner")):
        return
    outs = [e for e in read_log(pdir) if e.get("event") == "outcome"]
    if len(outs) >= 2 and outs[-1]["outcome"] == outs[-2]["outcome"] == "blocked":
        return
    set_status(pdir, "active", "")
    append_log(pdir, {"event": "auto_resume", "note": reason})
    flare(f"jarvis2/{slug}: auto-resumed a soft block ('{reason[:80]}') per the explore "
          f"autonomy contract — it sticks only if the next wave blocks again")


def cmd_tick(args) -> None:
    lock = open(ROOT / ".tick.lock", "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print("another tick is running; skipping")
        return
    if args.slug:
        pdir = project_dir(args.slug)
        maybe_auto_resume(args.slug)
        status = load_state(pdir)["status"]
        if status in ("paused", "dropped"):
            die(f"{args.slug} is {status} — `jarvis resume {args.slug}` first")
        if status == "blocked":
            die(f"{args.slug} is blocked ({load_state(pdir)['status_reason']}) — "
                f"resolve, then `jarvis resume {args.slug}`")
        if status == "done":
            die(f"{args.slug} is done")
        run_tick(args.slug)
        return
    for s in all_slugs():
        maybe_auto_resume(s)
    due = [s for s in all_slugs()
           if is_due(load_config(PROJECTS / s), load_state(PROJECTS / s))]
    if not due:
        print("nothing due")
        return
    for slug in due:
        run_tick(slug)


# ---------------------------------------------------------------- outcome

def cmd_outcome(args) -> None:
    pdir = project_dir(args.slug)
    tick = args.tick or os.environ.get("JARVIS2_TICK_ID", "manual")
    if args.outcome in ("blocked",) and not args.note:
        die("blocked outcomes need --note explaining what is needed")
    if args.outcome == "done" and mode_of(load_config(pdir)) == "explore":
        # Persistence guarantee, enforced: no session ends an exploration —
        # only the hours ledger (finish_exploration) or Daniel does.
        append_log(pdir, {"event": "outcome", "tick": tick, "outcome": "progress",
                          "note": f"[done->progress] {args.note}"})
        flare(f"jarvis2/{args.slug}: a session tried to declare the exploration done "
              f"('{args.note[:80]}') — downgraded to progress; the hours ledger decides "
              f"when explore projects end", sev="warn")
        print(f"recorded: {args.slug} progress (done is not a thing in explore mode)")
        return
    append_log(pdir, {"event": "outcome", "tick": tick,
                      "outcome": args.outcome, "note": args.note})
    if args.outcome == "blocked":
        set_status(pdir, "blocked", args.note)
        flare(f"jarvis2/{args.slug} BLOCKED: {args.note}", sev="warn")
    elif args.outcome == "done":
        missing = "" if (pdir / "reports" / "final.md").exists() \
            else " (WARNING: reports/final.md missing)"
        set_status(pdir, "done", args.note)
        flare(f"jarvis2/{args.slug} DONE{missing}: {args.note} — "
              f"final report: projects/{args.slug}/reports/final.md")
    elif args.outcome == "spec-ready":
        set_status(pdir, "active", "")
        if mode_of(load_config(pdir)) == "explore":
            flare(f"jarvis2/{args.slug}: exploration surveyed, question queue seeded — "
                  f"{args.note} | waves start next tick; edit interests.md anytime to "
                  f"steer; `jarvis pause {args.slug}` to veto, silence means it runs")
        else:
            flare(f"jarvis2/{args.slug}: spec drafted — {args.note} | review/edit "
                  f"projects/{args.slug}/spec.md; `jarvis pause {args.slug}` to veto, "
                  f"silence means it runs")
    print(f"recorded: {args.slug} {args.outcome} (tick {tick})")


# ---------------------------------------------------------------- lifecycle

def cmd_pause(args) -> None:
    set_status(project_dir(args.slug), "paused", args.reason or "paused by Daniel")
    print(f"{args.slug}: paused")


def cmd_resume(args) -> None:
    set_status(project_dir(args.slug), "active", "")
    print(f"{args.slug}: active")


def cmd_drop(args) -> None:
    set_status(project_dir(args.slug), "dropped", args.reason or "dropped")
    print(f"{args.slug}: dropped (directory kept; delete by hand if you mean it)")


def cmd_open(args) -> None:
    pdir = project_dir(args.slug)
    os.chdir(pdir)
    os.execvp("claude", ["claude"])


# ---------------------------------------------------------------- main

def main() -> None:
    p = argparse.ArgumentParser(prog="jarvis", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("new", help="idea -> new project")
    s.add_argument("idea", help="the idea — or, with --explore, the interests blurb")
    s.add_argument("--slug")
    s.add_argument("--explore", action="store_true",
                   help="open-ended exploration: repo + interests in, findings out")
    s.add_argument("--repo", help="(explore) repo URL to point the exploration at")
    s.add_argument("--hours", type=float, default=DEFAULT_EXPLORE_HOURS,
                   help="(explore) wall-clock hours owed; the scheduler delivers them")
    s.add_argument("--parallelism", type=int, default=DEFAULT_PARALLELISM,
                   help="(explore) workers per wave")
    s.add_argument("--budget-usd", type=float, default=DEFAULT_EXPLORE_USD,
                   help="(explore) spend cap; pre-approved up to this")
    s.set_defaults(fn=cmd_new)

    s = sub.add_parser("list", help="one row per project")
    s.set_defaults(fn=cmd_list)

    s = sub.add_parser("status", help="project detail")
    s.add_argument("slug")
    s.set_defaults(fn=cmd_status)

    s = sub.add_parser("tick", help="run due keeper ticks (bare = cron entrypoint)")
    s.add_argument("slug", nargs="?")
    s.set_defaults(fn=cmd_tick)

    s = sub.add_parser("outcome", help="record how a tick ended (keeper calls this)")
    s.add_argument("slug")
    s.add_argument("outcome", choices=["progress", "blocked", "done", "spec-ready"])
    s.add_argument("--note", default="")
    s.add_argument("--tick")
    s.set_defaults(fn=cmd_outcome)

    for name, fn in (("pause", cmd_pause), ("resume", cmd_resume), ("drop", cmd_drop)):
        s = sub.add_parser(name)
        s.add_argument("slug")
        s.add_argument("--reason", default="")
        s.set_defaults(fn=fn)

    s = sub.add_parser("open", help="interactive session in the project dir")
    s.add_argument("slug")
    s.set_defaults(fn=cmd_open)

    args = p.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
