# Source of truth for jarvis's cron entries on the devbox. The live crontab
# block is a build artifact: edit THIS file (via PR), then run
# ops/install-cron.sh to reconcile. Never hand-edit the managed block in
# `crontab -e` — and never add jarvis-ecosystem entries outside it.
# Verify sync any time with: ops/install-cron.sh --check
#
# Assumes: single devbox, jarvis at /mnt/nw/home/d.tan/jarvis, claude CLI at
# /mnt/nw/home/d.tan/.local/bin/claude, arsenal venv at repos/arsenal/.venv.
# Sibling pattern: repos/investment owns its own managed block via its own
# ops/cron.tab — one block per repo, installers never touch each other's.

# memory-consolidate: weekly memory→wiki consolidation (jarvis wiki, PR #103)
11 8 * * 1 cd /mnt/nw/home/d.tan/jarvis && /mnt/nw/home/d.tan/.local/bin/claude -p "Run a memory consolidation per the procedure in .claude/skills/memory-consolidate/SKILL.md (if not on main yet, read it via: git show origin/llm-wiki:.claude/skills/memory-consolidate/SKILL.md). Follow its guardrails exactly; open the wiki PR; leave a summary in the log file." --dangerously-skip-permissions >> /mnt/nw/home/d.tan/.claude/logs/memory-consolidate.log 2>&1

# habitat: nightly backup (source currently untracked in ~/.habitat — see issue: habitat backup.py into arsenal)
17 3 * * * python3 /mnt/nw/home/d.tan/.habitat/backup.py >> /mnt/nw/home/d.tan/.habitat/backup.log 2>&1

# runpod-availability: Instant Cluster availability benchmark (jarvis experiments/runpod-availability; deployed copy in ~/jarvis-data)
*/15 * * * * flock -n /tmp/runpod-avail.lock python3 /mnt/nw/home/d.tan/jarvis-data/runpod-availability/poll.py --out /mnt/nw/home/d.tan/jarvis-data/runpod-availability/results.jsonl --confirm-shape H200:8 --confirm-shape H200:4 --confirm-shape H100:8 --confirm-max-creates-per-day 2 >> /mnt/nw/home/d.tan/jarvis-data/runpod-availability/poll.log 2>&1

# pod-audit: weekly RunPod leak detector (jarvis ops/pod-audit; deployed copy in ~/jarvis-data)
23 9 * * 1 python3 /mnt/nw/home/d.tan/jarvis-data/pod-audit/audit.py --allowlist /mnt/nw/home/d.tan/jarvis-data/pod-audit/allowlist.json --out /mnt/nw/home/d.tan/jarvis-data/pod-audit/audit.jsonl --github-repo ArcadiaImpact/jarvis >> /mnt/nw/home/d.tan/jarvis-data/pod-audit/audit.log 2>&1

# deploy: after the nightly sweep, pull merged main into the pinned checkouts,
# refresh the arsenal venv + PATH links, and reconcile the crontab. Without
# this, gazette-merged tool/cron changes sit undeployed until a session
# happens to pull — consumer mode needs merge→deploy to be automatic too.
# (install-cron.sh here re-installs from the freshly pulled cron.tab, so a
# merged cron change goes live the same night; ff-only aborts safely if a
# checkout ever diverges.)
10 4 * * * cd /mnt/nw/home/d.tan/jarvis && git pull --ff-only -q && git -C repos/arsenal pull --ff-only -q && (cd repos/arsenal && /mnt/nw/home/d.tan/.local/bin/uv sync --all-packages -q && ops/link-clis.sh) && ops/install-cron.sh >> /mnt/nw/home/d.tan/.claude/logs/deploy.log 2>&1

# jarvis-memory: nightly auto-snapshot commit+push
41 3 * * * cd /mnt/nw/home/d.tan/jarvis-memory && git add -A && git commit -qm "auto-snapshot $(date +\%F)" >/dev/null 2>&1; git push -q >> /mnt/nw/home/d.tan/.claude/logs/memory-backup.log 2>&1

# gazette: nightly lane-respecting PR merge sweep (consumer-mode PR flow — see
# CLAUDE.md "PR lanes"); morning edition at 08:05 (spooled + flare; folds in
# the desk digest, so there is no separate desk→flare cron — see
# docs/morning-routine.md)
29 3 * * * /mnt/nw/home/d.tan/jarvis/repos/arsenal/.venv/bin/gazette sweep >> /mnt/nw/home/d.tan/.claude/logs/gazette.log 2>&1
5 8 * * * /mnt/nw/home/d.tan/jarvis/repos/arsenal/.venv/bin/gazette notes --flare >> /mnt/nw/home/d.tan/.claude/logs/gazette.log 2>&1

# desk: hourly inbox sync (new blocked items still flare immediately)
7 * * * * /mnt/nw/home/d.tan/jarvis/repos/arsenal/.venv/bin/desk sync >> /mnt/nw/home/d.tan/.claude/logs/desk.log 2>&1

# threads: daily activity refresh — summarize new sessions, re-weave onto the
# registry (weave also refreshes the Obsidian vault). scan needs the API key
# from ~/.env; hitting the per-run call cap self-reports via flare.
19 7 * * * set -a; . /mnt/nw/home/d.tan/.env; set +a; /mnt/nw/home/d.tan/jarvis/repos/arsenal/.venv/bin/threads scan && /mnt/nw/home/d.tan/jarvis/repos/arsenal/.venv/bin/threads weave >> /mnt/nw/home/d.tan/.claude/logs/threads.log 2>&1
