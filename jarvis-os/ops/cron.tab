# Source of truth for jarvis's cron entries on the devbox. The live crontab
# block is a build artifact: edit THIS file (via PR), then run
# ops/install-cron.sh to reconcile. Never hand-edit the managed block in
# `crontab -e` — and never add jarvis-ecosystem entries outside it.
# Verify sync any time with: ops/install-cron.sh --check
#
# Assumes: single devbox, jarvis at /mnt/nw/home/d.tan/jarvis, claude CLI at
# /mnt/nw/home/d.tan/.local/bin/claude, workspace venv at the monorepo root
# (/mnt/nw/home/d.tan/jarvis-monorepo/.venv — see root pyproject.toml).
# Sibling pattern: repos/investment owns its own managed block via its own
# ops/cron.tab — one block per repo, installers never touch each other's.

# cron runs with a minimal PATH (typically /usr/bin:/bin), so the jarvis CLIs'
# shell-outs can't find binaries in ~/.local/bin — e.g. gazette → `gh`, which
# on 2026-08-18 silently degraded the morning edition to a false "quiet" day
# (issue #21), and threads → `claude`. Set PATH once for every managed entry
# below (env lines apply to all following cron jobs) so the next missing CLI
# doesn't reproduce the bug. This is the source-of-truth fix; ops/link-clis.sh
# populates ~/.local/bin and gazette also resolves `gh` via shutil.which as a
# belt-and-braces fallback.
PATH=/mnt/nw/home/d.tan/.local/bin:/usr/local/bin:/usr/bin:/bin

# memory-consolidate: weekly memory→wiki consolidation (jarvis wiki, PR #103)
11 8 * * 1 cd /mnt/nw/home/d.tan/jarvis && /mnt/nw/home/d.tan/.local/bin/claude -p "Run a memory consolidation per the procedure in .claude/skills/memory-consolidate/SKILL.md (if not on main yet, read it via: git show origin/llm-wiki:.claude/skills/memory-consolidate/SKILL.md). Follow its guardrails exactly; open the wiki PR; leave a summary in the log file." --dangerously-skip-permissions >> /mnt/nw/home/d.tan/.claude/logs/memory-consolidate.log 2>&1

# habitat: nightly backup (source currently untracked in ~/.habitat — see issue: habitat backup.py into arsenal)
17 3 * * * python3 /mnt/nw/home/d.tan/.habitat/backup.py >> /mnt/nw/home/d.tan/.habitat/backup.log 2>&1

# runpod-availability: Instant Cluster availability benchmark (jarvis experiments/runpod-availability; deployed copy in ~/jarvis-data)
*/15 * * * * flock -n /tmp/runpod-avail.lock python3 /mnt/nw/home/d.tan/jarvis-data/runpod-availability/poll.py --out /mnt/nw/home/d.tan/jarvis-data/runpod-availability/results.jsonl --confirm-shape H200:8 --confirm-shape H200:4 --confirm-shape H100:8 --confirm-max-creates-per-day 2 >> /mnt/nw/home/d.tan/jarvis-data/runpod-availability/poll.log 2>&1

# pod-audit: weekly RunPod leak detector (jarvis ops/pod-audit; deployed copy in ~/jarvis-data)
23 9 * * 1 python3 /mnt/nw/home/d.tan/jarvis-data/pod-audit/audit.py --allowlist /mnt/nw/home/d.tan/jarvis-data/pod-audit/allowlist.json --out /mnt/nw/home/d.tan/jarvis-data/pod-audit/audit.jsonl --github-repo ArcadiaImpact/jarvis >> /mnt/nw/home/d.tan/jarvis-data/pod-audit/audit.log 2>&1

# deploy: nightly version cut + deploy. `version cut` tags origin/main's tip
# as vYYYY.MM.DD (the night's JARVIS version); `version deploy` deploys it —
# pull the pinned checkout forward (or honor a `gazette version switch`
# rollback pin) and re-run the post-deploy steps (uv sync, link-clis,
# install-cron) so venv/CLIs/crontab always match the deployed tree. Merges
# happen hourly, but the BOX changes only here — this is the version boundary.
# Rollback: gazette version switch v<date>; resume: gazette version switch latest.
10 4 * * * { /mnt/nw/home/d.tan/jarvis-monorepo/.venv/bin/gazette version cut && /mnt/nw/home/d.tan/jarvis-monorepo/.venv/bin/gazette version deploy; } >> /mnt/nw/home/d.tan/.claude/logs/deploy.log 2>&1

# jarvis-memory: nightly auto-snapshot commit+push
41 3 * * * cd /mnt/nw/home/d.tan/jarvis-memory && git add -A && git commit -qm "auto-snapshot $(date +\%F)" >/dev/null 2>&1; git push -q >> /mnt/nw/home/d.tan/.claude/logs/memory-backup.log 2>&1

# gazette: hourly merge-on-green sweep (consumer-mode PR flow — see CLAUDE.md
# "PR flow"; auto merges on green within the hour, requires-approval never);
# morning edition at 08:05 (spooled + flare; folds in the desk digest, so
# there is no separate desk→flare cron — see docs/morning-routine.md)
29 * * * * /mnt/nw/home/d.tan/jarvis-monorepo/.venv/bin/gazette sweep >> /mnt/nw/home/d.tan/.claude/logs/gazette.log 2>&1
5 8 * * * /mnt/nw/home/d.tan/jarvis-monorepo/.venv/bin/gazette notes --flare >> /mnt/nw/home/d.tan/.claude/logs/gazette.log 2>&1

# desk: hourly inbox sync (new blocked items still flare immediately)
7 * * * * /mnt/nw/home/d.tan/jarvis-monorepo/.venv/bin/desk sync >> /mnt/nw/home/d.tan/.claude/logs/desk.log 2>&1

# threads: daily activity refresh — summarize new sessions, re-weave onto the
# registry (weave also refreshes the Obsidian vault). scan needs the API key
# from ~/.env; hitting the per-run call cap self-reports via flare.
19 7 * * * set -a; . /mnt/nw/home/d.tan/.env; set +a; /mnt/nw/home/d.tan/jarvis-monorepo/.venv/bin/threads scan && /mnt/nw/home/d.tan/jarvis-monorepo/.venv/bin/threads weave >> /mnt/nw/home/d.tan/.claude/logs/threads.log 2>&1

# mailroom: 2-hourly thought-capture ingest + route — pull Daniel's captures
# from Slack #lab-notes-daniel, the Todoist Inbox, and voice memos into the
# spool (✅ loop-closure reactions), then triage + land each on a spine
# (threads notes, Todoist projects, goal files, papers, flare). Sources ~/.env
# for Slack/Todoist/Anthropic creds; the per-run triage call-cap self-reports
# via flare on truncation.
15 */2 * * * set -a; . /mnt/nw/home/d.tan/.env; set +a; /mnt/nw/home/d.tan/jarvis-monorepo/.venv/bin/mailroom ingest && /mnt/nw/home/d.tan/jarvis-monorepo/.venv/bin/mailroom route >> /mnt/nw/home/d.tan/.claude/logs/mailroom.log 2>&1

# mailroom: daily digest — flare the headline (--sev info) on non-empty days
# (the veto surface; full page served via `mailroom serve` → lobby /a/mailroom/).
33 7 * * * set -a; . /mnt/nw/home/d.tan/.env; set +a; /mnt/nw/home/d.tan/jarvis-monorepo/.venv/bin/mailroom render --flare >> /mnt/nw/home/d.tan/.claude/logs/mailroom.log 2>&1

# watchman: 6-hourly background-thinking pass (docs/background-thinking.md) —
# propose-only judgment over goal frontiers / threads / desk / recent
# activity; ≤3 observations per run via one batched info flare + thread
# notes, silent when nothing clears the bar. The 07:45 run lands fresh
# observations just before the 08:05 morning edition.
45 1,7,13,19 * * * cd /mnt/nw/home/d.tan/jarvis && /mnt/nw/home/d.tan/.local/bin/claude -p "Run the watchman pass per .claude/skills/watchman/SKILL.md. Follow its hard rules exactly — propose-only, at most 3 observations, silence is the expected default." --dangerously-skip-permissions >> /mnt/nw/home/d.tan/.claude/logs/watchman.log 2>&1

# goal-review: weekly propose-only planner cycle (rung 1 of
# docs/background-thinking.md) — frontier refresh + fully-specced proposals
# as a review PR for checkbox veto; Tuesday 06:45 so the PR surfaces in that
# morning's edition.
45 6 * * 2 cd /mnt/nw/home/d.tan/jarvis && /mnt/nw/home/d.tan/.local/bin/claude -p "Run a goal-review cycle per .claude/skills/goal-review/SKILL.md. Follow its hard rules exactly — propose-only, report even if nothing changed, open the review PR (no lane label needed — it merges on green)." --dangerously-skip-permissions >> /mnt/nw/home/d.tan/.claude/logs/goal-review.log 2>&1
