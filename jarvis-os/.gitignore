__pycache__/
.DS_Store
.claude/worktrees

# External repo clones (not part of jarvis; re-clone via jarvis.config.yaml)
repos/

# Experiment data dirs: derived/runtime datasets, incl. the EM training prompts
# which are deliberately scrape-protected (easy-dataset-share canaries) upstream.
experiments/*/data/

# Personal files, e.g. customization, server-specific config, etc.
personal/
# Experiment results: caches, datasets, training logs, raw eval records (regenerable)
experiments/*/results/
