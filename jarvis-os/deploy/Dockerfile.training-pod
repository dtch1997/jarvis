# Persistent training pod: control plane + HF/PEFT LoRA trainer (spec §4.1 C).
# Built for one 80GB GPU (Qwen3.6-27B LoRA). The Network Volume mounts at
# /mnt/volume and holds the tinker:// blob store.
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y python3.11 python3-pip git && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY open-tinker /app/open-tinker
COPY open-tinker-server /app/open-tinker-server

# torch matched to the CUDA base; then the training extra (transformers/peft/accelerate).
RUN pip3 install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cu124 \
 && pip3 install --no-cache-dir -e /app/open-tinker \
 && pip3 install --no-cache-dir -e '/app/open-tinker-server[train]'

ENV OPEN_TINKER_BLOB_ROOT=/mnt/volume \
    OPEN_TINKER_BASE_MODEL=Qwen/Qwen3.6-27B \
    PORT=8200
EXPOSE 8200
CMD ["open-tinker-server"]
