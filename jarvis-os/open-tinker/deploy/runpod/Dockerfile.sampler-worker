# Serverless sampling worker: vLLM + LoRA hot-load (spec §4.1 D, task #7).
# RunPod serverless entrypoint = open_tinker_server.sampler_worker:main.
# The Network Volume mounts at /runpod-volume and holds sampler_weights adapters.
FROM vllm/vllm-openai:latest

ENV PYTHONUNBUFFERED=1
WORKDIR /app
# Build context = the open-tinker/ umbrella (client/ + server/).
COPY . /app/open-tinker

RUN pip install --no-cache-dir runpod \
 && pip install --no-cache-dir -e /app/open-tinker/client \
 && pip install --no-cache-dir -e '/app/open-tinker/server[sample]'

ENV OPEN_TINKER_BLOB_ROOT=/runpod-volume \
    OPEN_TINKER_BASE_MODEL=Qwen/Qwen3.6-27B
# RunPod serverless invokes the handler; no port.
CMD ["python", "-m", "open_tinker_server.sampler_worker"]
