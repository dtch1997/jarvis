# Workspace build artifacts — the uv workspace root (and its .venv) is this
# monorepo root; see pyproject.toml.
.venv/
__pycache__/
*.egg-info/
dist/
.pytest_cache/
.claude/worktrees/
/jarvis-memory/

# repos/ clones are pointer-only (see CLAUDE.md); MANIFEST.md is the pointer
/repos/*
!/repos/MANIFEST.md
